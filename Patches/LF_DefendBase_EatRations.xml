<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <!-- La reserva central (orden vanilla DefendBase): come de sus raciones o de la despensa cuando tiene
       hambre, y sus técnicos recargan generadores y torretas. Se inserta justo después del combate, así que
       nunca interrumpe una pelea. -->
  <Operation Class="PatchOperationInsert">
    <xpath>/Defs/DutyDef[defName="DefendBase"]/thinkNode/subNodes/li[@Class="JobGiver_AIDefendPoint"]</xpath>
    <order>Append</order>
    <value>
      <li Class="LivingFactions.AI.JobGiver_LFEatRation" />
      <li Class="LivingFactions.AI.JobGiver_LFMaintain" />
    </value>
  </Operation>

</Patch>
